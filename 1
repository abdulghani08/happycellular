Options -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# =========================
# REDIRECT .PHP -> NON PHP
# =========================
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# =========================
# REMOVE .PHP EXTENSION
# =========================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

</IfModule>